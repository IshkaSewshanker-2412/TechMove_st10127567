@model TechMoveGLMS.Models.ServiceRequest
@using Microsoft.AspNetCore.Mvc.Rendering

<h2>Create Service Request</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Contract</label>
        <select asp-for="ContractId" asp-items="ViewBag.Contracts" class="form-control"></select>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Cost">Cost (USD)</label>
        <input asp-for="Cost" type="number" step="0.01" class="form-control" id="usdCost" />
        <small class="form-text text-muted">
            Enter the amount in USD. It will be converted to ZAR automatically when saved.
        </small>
        <!-- Live preview -->
        <p id="zarPreview" class="text-info mt-2"></p>
    </div>

    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-control">
            <option>Pending</option>
            <option>Completed</option>
            <option>Cancelled</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
</form>

@section Scripts {
    <script>
        // Simple client-side preview using a fixed rate (for demo)
        const rate = 16.63; // You can adjust or fetch dynamically
        document.getElementById("usdCost").addEventListener("input", function () {
            const usd = parseFloat(this.value);
            if (!isNaN(usd)) {
                const zar = (usd * rate).toFixed(2);
                document.getElementById("zarPreview").innerText = `Approximate ZAR: R${zar}`;
            } else {
                document.getElementById("zarPreview").innerText = "";
            }
        });
    </script>
}
