@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <!-- Centered Logo -->
    <img src="~/images/Logo.png" alt="TechMove GLMS Logo"
         class="img-fluid mb-4 home-logo" style="max-width:300px;" />

    <!-- Action Buttons -->
    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Contracts" asp-action="Create" class="btn btn-primary btn-lg home-btn">
            Create Contract
        </a>
        <a asp-controller="Clients" asp-action="Create" class="btn btn-success btn-lg home-btn">
            Create Client
        </a>
        <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-info btn-lg home-btn">
            Service Request
        </a>
    </div>
</div>
