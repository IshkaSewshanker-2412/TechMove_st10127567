@model TechMoveGLMS.Models.ServiceRequest
@using Microsoft.AspNetCore.Mvc.Rendering

<h2>Create Service Request</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Hidden field ensures ContractId is carried over when coming from Contract Details -->
    <input type="hidden" asp-for="ContractId" />

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Cost">Cost (USD)</label>
        <input asp-for="Cost" type="number" step="0.01" class="form-control" id="usdCost" />
        <small class="form-text text-muted">
            Enter the amount in USD. It will be converted to ZAR automatically when saved.
        </small>
        <p id="zarPreview" class="text-info mt-2"></p>
    </div>

    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-control">
            <option>Pending</option>
            <option>In Progress</option>
            <option>Completed</option>
            <option>Cancelled</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-secondary">Back to Contract</a>
</form>

@section Scripts {
    <script>
        const rate = 16.63; // demo conversion rate
        document.getElementById("usdCost").addEventListener("input", function () {
            const usd = parseFloat(this.value);
            if (!isNaN(usd)) {
                const zar = (usd * rate).toFixed(2);
                document.getElementById("zarPreview").innerText = `Approximate ZAR: R${zar}`;
            } else {
                document.getElementById("zarPreview").innerText = "";
            }
        });
    </script>
}
