@model IEnumerable<TechMoveGLMS.Models.ContractDto>


<h2>Contracts</h2>

@* Search filter *@
<form asp-action="Search" method="get" class="mb-3">
    <label>Start Date:</label>
    <input type="date" name="startDate" />
    <label>End Date:</label>
    <input type="date" name="endDate" />
    <label>Status:</label>
    <input type="text" name="status" />
    <button type="submit" class="btn btn-info">Search</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Client</th>
            <th>Service Level</th>
            <th>Status</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contract in Model)
        {
            <tr>
                <td>@contract.Client?.Name</td>
                <td>@contract.ServiceLevel</td>
                <td>@contract.Status</td>
                <td>@contract.StartDate.ToShortDateString()</td>
                <td>@contract.EndDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@contract.Id" class="btn btn-primary btn-sm">
                        View Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

