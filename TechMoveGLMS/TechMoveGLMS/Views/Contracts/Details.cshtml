@model TechMoveGLMS.Models.ContractDto

<h2>Contract Details</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p><strong>Client:</strong> @Model.Client?.Name</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Service Level:</strong> @Model.ServiceLevel</p>

<form asp-action="UploadAgreement" asp-route-id="@Model.Id" enctype="multipart/form-data" method="post">
    <input type="file" name="file" accept="application/pdf" />
    <button type="submit" class="btn btn-primary">Upload PDF</button>
</form>

@if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
{
    <p>
        <a asp-action="DownloadAgreement" asp-route-id="@Model.Id" class="btn btn-success">
            Download Signed Agreement
        </a>
    </p>
}

<h3>Service Requests</h3>

@if (Model.ServiceRequests != null && Model.ServiceRequests.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Cost (ZAR)</th>
                <th>Status</th>
                <th>Client Name</th>
                <th>Service Level</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.ServiceRequests)
            {
                <tr>
                    <td>@request.Description</td>
                    <td>@request.Cost.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td>
                    <td>@request.Status</td>
                    <td>@Model.Client?.Name</td>       <!-- ✅ use parent contract -->
                    <td>@Model.ServiceLevel</td>       <!-- ✅ use parent contract -->
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No service requests for this contract.</p>
}

<div class="mt-3">
    <a asp-controller="ServiceRequests"
           asp-action="Create"
           asp-route-contractId="@Model.Id"
           class="btn btn-primary">
        Create Service Request
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        Back to Contracts
    </a>
</div>




